{
  "name": "phonemail",
  "version": "1.0.0",
  "description": "PhoneMail - Email platform where your phone number is your email address",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/style.css --watch"
  },
  "keywords": [
    "phonemail",
    "twilio",
    "email",
    "tailwind",
    "sqlite"
  ],
  "author": "PhoneMail Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "twilio": "^5.4.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.3.3"
  }
}
